generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  CLIENTE
  KINESIOLOGO
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductType {
  STARFEET
  SLIPPER
  OTHER
}

enum PhysicalSize {
  S
  M
  L
}

enum OrderStatus {
  INITIATED
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Currency {
  ARS
  USD
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum CommissionStatus {
  PENDING
  VALIDATED
  PAID
  REJECTED
}

enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  WEB
  KINESIO
  SOCIAL
  REFERRAL
  OTHER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
}

// ─── Auth models (next-auth) ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  slug           String?   @unique
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  phone          String?
  documentNumber String?
  role           Role      @default(CLIENTE)
  isActive       Boolean   @default(true)
  failedLoginAttempts Int      @default(0)
  lockoutUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]

  // Kinesio relations
  assignedCoupons   CouponAssignment[] @relation("KinesioAssignments")
  commissionEntries CommissionEntry[]  @relation("KinesioCommissions")
  kinesioLinks      PatientKinesioLink[] @relation("KinesioLinks")
  payoutPeriods     PayoutPeriod[]       @relation("KinesioPayouts")
  accessCodes       AccessCode[]         @relation("UserAccessCodes")

  // Admin/creator relations
  createdCoupons    Coupon[]           @relation("CouponCreator")
  couponAssignments CouponAssignment[] @relation("AssignedBy")
  ownedLeads        Lead[]             @relation("LeadOwner")
  createdCampaigns  Campaign[]         @relation("CampaignCreator")
  updatedSystemSettings SystemSetting[] @relation("SystemSettingUpdatedBy")

  // Cart
  carts Cart[]

  @@map("users")
}

// ─── Coupon ───────────────────────────────────────────────────────────────────

model Coupon {
  id              String       @id @default(cuid())
  slug            String?      @unique
  code            String       @unique
  discountType    DiscountType
  discountValue   Float
  commissionType  DiscountType @default(PERCENTAGE)
  commissionValue Float        @default(0)
  maxUses         Int          @default(100)
  usageCount      Int          @default(0)
  isStackable     Boolean      @default(false)
  isActive        Boolean      @default(true)
  expiresAt       DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy         User?              @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments       CouponAssignment[]
  commissionEntries CommissionEntry[]
  orders            Order[]
  redemptions       CouponRedemption[]
  patientKinesioLinksAsFirstCoupon PatientKinesioLink[] @relation("PatientKinesioLinkFirstCoupon")
  carts             Cart[]           @relation("CouponCarts")

  @@map("coupons")
}

model CouponAssignment {
  id            String   @id @default(cuid())
  couponId      String
  kinesioUserId String
  assignedById  String?
  assignedAt    DateTime @default(now())

  coupon      Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  kinesioUser User   @relation("KinesioAssignments", fields: [kinesioUserId], references: [id], onDelete: Cascade)
  assignedBy  User?  @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([couponId, kinesioUserId])
  @@map("coupon_assignments")
}

model CouponRedemption {
  id                String   @id @default(cuid())
  couponId          String
  orderId           String   @unique
  redeemedByUserId   String?
  usedByEmail       String
  discountSnapshot  Decimal  @db.Decimal(12, 2)
  commissionSnapshot Decimal  @db.Decimal(12, 2)
  usedAt            DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("coupon_redemptions")
}

// ─── CommissionEntry ──────────────────────────────────────────────────────────

model CommissionEntry {
  id            String           @id @default(cuid())
  kinesioUserId String
  orderId       String
  couponId      String?
  payoutId      String?
  amount        Decimal          @db.Decimal(12, 2)
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  kinesioUser User          @relation("KinesioCommissions", fields: [kinesioUserId], references: [id], onDelete: Cascade)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon      Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payout      PayoutPeriod? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@map("commission_entries")
}

// ─── PayoutPeriod ─────────────────────────────────────────────────────────────

model PayoutPeriod {
  id            String    @id @default(cuid())
  kinesioUserId String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Decimal   @db.Decimal(12, 2)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  kinesioUser       User              @relation("KinesioPayouts", fields: [kinesioUserId], references: [id], onDelete: Cascade)
  commissionEntries CommissionEntry[]

  @@map("payout_periods")
}

// ─── PatientKinesioLink ───────────────────────────────────────────────────────

model PatientKinesioLink {
  id            String   @id @default(cuid())
  kinesioUserId String
  patientId     String
  firstCouponId String?
  firstOrderId  String?
  notes         String?
  linkedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kinesioUser User           @relation("KinesioLinks", fields: [kinesioUserId], references: [id], onDelete: Cascade)
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  firstCoupon Coupon?        @relation("PatientKinesioLinkFirstCoupon", fields: [firstCouponId], references: [id], onDelete: SetNull)
  firstOrder  Order?         @relation("PatientKinesioLinkFirstOrder", fields: [firstOrderId], references: [id], onDelete: SetNull)

  @@unique([kinesioUserId, patientId])
  @@map("patient_kinesio_links")
}

// ─── PatientProfile (perfil clínico separado) ─────────────────────────────────

model PatientProfile {
  id        String   @id @default(cuid())
  slug      String?  @unique
  name      String?
  email     String?  @unique
  phone     String?
  notes     String?
  linkedUserId String?
  source    String?
  firstOrderAt DateTime?
  lastOrderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kinesioLinks PatientKinesioLink[]
  orders       Order[]

  @@map("patient_profiles")
}

// ─── CRM: Lead ────────────────────────────────────────────────────────────────

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  source    LeadSource @default(WEB)
  status    LeadStatus @default(NEW_LEAD)
  interest  String?
  notes     String?
  ownerId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  owner      User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities LeadActivity[]

  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  content   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

// ─── CRM: Campaign ────────────────────────────────────────────────────────────

model Campaign {
  id          String         @id @default(cuid())
  name        String
  subject     String?
  body        String?
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy  User?               @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  email      String
  sentAt     DateTime?
  openedAt   DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@map("campaign_recipients")
}

// ─── Access Codes ────────────────────────────────────────────────────────────

model AccessCode {
  id         String   @id @default(cuid())
  email      String
  userId     String?
  type       String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User? @relation("UserAccessCodes", fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, type])
  @@map("access_codes")
}

// ─── System Settings ─────────────────────────────────────────────────────────

model SystemSetting {
  id          String   @id @default(cuid())
  category    String
  key         String
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, key])
  @@map("system_settings")
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id                String      @id @default(cuid())
  slug              String?     @unique
  name              String
  description       String?
  type              ProductType
  imageUrls         String[]
  priceArs          Decimal
  priceUsd          Decimal
  compareAtPriceArs Decimal?
  compareAtPriceUsd Decimal?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  inventories ProductInventory[]
  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@map("products")
}

model ProductInventory {
  id                String       @id @default(cuid())
  sku               String       @unique
  physicalSize      PhysicalSize
  color             String       @default("Negro")
  stock             Int          @default(0)
  lowStockThreshold Int          @default(5)
  isActive          Boolean      @default(true)
  sortOrder         Int          @default(0)
  productId         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("product_inventories")
}

// ─── Cart ─────────────────────────────────────────────────────────────────────

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  guestId        String?    @unique
  customerEmail  String
  currency       Currency   @default(ARS)
  status         CartStatus @default(ACTIVE)
  couponId       String?
  expiresAt      DateTime
  lastActivityAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?   @relation("CouponCarts", fields: [couponId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  inventoryId String?
  quantity    Int      @default(1)
  unitPrice   Decimal
  gender      Gender?
  size        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart      Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory ProductInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@map("cart_items")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id                  String      @id @default(cuid())
  slug               String?     @unique
  status              OrderStatus
  currency            Currency
  totalAmount         Decimal
  snapshotClientName  String?
  snapshotClientEmail String?
  snapshotClientPhone String?
  paymentProvider     String?
  transactionId       String?
  shippingDetails     Json?
  recoveryEmailSent   Boolean     @default(false)
  userId              String?
  patientId           String?
  couponId            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient           PatientProfile?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  commissionEntries CommissionEntry[]
  couponRedemption  CouponRedemption?
  patientKinesioLinksAsFirstOrder PatientKinesioLink[] @relation("PatientKinesioLinkFirstOrder")

  @@map("orders")
}

model OrderItem {
  id                 String        @id @default(cuid())
  quantity           Int
  unitPrice          Decimal
  userSelectedGender Gender
  userSelectedSize   String
  adminResolvedSize  PhysicalSize?
  orderId            String
  productId          String
  inventoryId        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory ProductInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
