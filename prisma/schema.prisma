generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  KINESIOLOGO
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProductType {
  STARFEET
  SLIPPER
  OTHER
}

enum PhysicalSize {
  S
  M
  L
}

enum OrderStatus {
  INITIATED
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum Currency {
  ARS
  USD
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  phone          String?
  documentNumber String?
  role           Role      @default(CLIENTE)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  coupons  Coupon[]
  orders   Order[]

  @@map("users")
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountValue Float
  discountType  DiscountType
  usageCount    Int          @default(0)
  isActive      Boolean      @default(true)
  userId        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("coupons")
}

model Product {
  id                String      @id @default(cuid())
  name              String
  description       String?
  type              ProductType
  imageUrls         String[]
  priceArs          Decimal
  priceUsd          Decimal
  compareAtPriceArs Decimal?
  compareAtPriceUsd Decimal?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  inventories ProductInventory[]
  orderItems  OrderItem[]

  @@map("products")
}

model ProductInventory {
  id                String       @id @default(cuid())
  sku               String       @unique
  physicalSize      PhysicalSize
  stock             Int          @default(0)
  lowStockThreshold Int          @default(5)
  productId         String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("product_inventories")
}

model Order {
  id                  String      @id @default(cuid())
  status              OrderStatus
  currency            Currency
  totalAmount         Decimal
  snapshotClientName  String?
  snapshotClientEmail String?
  snapshotClientPhone String?
  paymentProvider     String?
  transactionId       String?
  shippingDetails     Json?
  recoveryEmailSent   Boolean     @default(false)
  userId              String
  couponId            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id                 String        @id @default(cuid())
  quantity           Int
  unitPrice          Decimal
  userSelectedGender Gender
  userSelectedSize   String
  adminResolvedSize  PhysicalSize?
  orderId            String
  productId          String
  inventoryId        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory ProductInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
